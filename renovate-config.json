{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "dependencyDashboard": true,
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "America/New_York",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "skipInstalls": false,
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Group all non-major updates into one PR per ecosystem",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major ({{manager}})",
      "groupSlug": "non-major-{{manager}}"
    }
  ]
}
